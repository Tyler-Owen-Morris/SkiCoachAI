# Postgres connection string (Neon free tier works well).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Long random string used to sign sign-in tokens.
TOKEN_SECRET=change-me
# Shared passcode for the demo. Leave empty to allow only bring-your-own-key sign-in.
DEMO_PASSCODE=
# Our OpenAI key, used only for passcode sign-ins. Use a project key with a spending cap.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
AI_RATE_LIMIT_PER_HOUR=120
# For the web build only: API server address (blank = same origin).
VITE_API_BASE=
